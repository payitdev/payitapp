{
  "name": "payit-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"import('fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "pnpm clean && tsc && node scripts/verify-build.js",
    "start": "node dist/server.js",
    "dev": "npx tsx src/server.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@magic-sdk/admin": "^2.3.0",
    "@payit/ai": "workspace:*",
    "@payit/contracts": "workspace:*",
    "@payit/db": "workspace:*",
    "@payit/integrations": "workspace:*",
    "@payit/ledger": "workspace:*",
    "@payit/security": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.26.1",
    "near-api-js": "^7.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3"
  }
}
