{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@payit/db": ["../../packages/db/dist/index.d.ts"],
      "@payit/db/schema": ["../../packages/db/dist/schema.d.ts"],
      "@payit/integrations": ["../../packages/integrations/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}

