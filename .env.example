# PayIT Environment Configuration Template

# PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Nuvion Payment Platform
NUVION_API_KEY=nv_live_sk_xxx
NUVION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Particle Network
PARTICLE_PROJECT_ID=your_particle_project_id
PARTICLE_CLIENT_KEY=your_particle_client_key
PARTICLE_SERVER_KEY=your_particle_server_key

# Magic Link
MAGIC_PUBLISHABLE_KEY=pk_live_xxx
MAGIC_SECRET_KEY=sk_live_xxx

# Frontend Vite Variables
VITE_PARTICLE_PROJECT_ID=your_particle_project_id
VITE_PARTICLE_CLIENT_KEY=your_particle_client_key
VITE_MAGIC_PUBLISHABLE_KEY=pk_live_xxx
VITE_NUVION_API_KEY=nv_live_sk_xxx
