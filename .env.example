# PayIT Environment Configuration Template
# Safety-first defaults: live finance is disabled until explicitly enabled.

# Runtime and deployment mode
NODE_ENV=development
ENABLE_LIVE_FINANCE=false
ENABLE_PODS_FINANCE=false
ENABLE_ONDO_FINANCE=false

# PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Core app config
JWT_SECRET=replace-with-a-long-random-secret
PROXIM_TREASURY_WALLET=0xyour-mainnet-treasury-address
FIAT_PROVIDER_LIVE=false
ADMIN_SEED_SECRET=replace-with-a-long-random-secret-at-least-16-characters
CORS_ORIGIN=http://localhost:3000

# Telegram Bot and Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-16-characters
TELEGRAM_MINI_APP_URL=https://your-mobile-web-host.example.com
PAYIT_BACKEND_URL=https://your-backend-host.example.com

# NEAR Intents 1Click v0 API
NEAR_INTENT_BASE_URL=https://1click.chaindefuser.com
NEAR_INTENT_1CLICK_API_KEY=
NEAR_INTENT_EXPLORER_API_KEY=

# NEAR Chain Signatures Mainnet
NEAR_NETWORK_ID=mainnet
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=
NEAR_GAS_TREASURY_IDENTIFIER=proxim-gas-treasury
NEAR_RPC_URL=https://rpc.mainnet.near.org
NEAR_NAMED_ACCOUNT_SECRET=replace-with-a-stable-secret-for-named-account-signing

# Pods / Ondo / savings integrations
PODS_API_KEY=
PODS_BASE_URL=
PODS_API_BASE_URL=
ONDO_API_KEY=

# Privy Configuration
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_CLIENT_ID=

# Nuvion Payment Platform
NUVION_ENABLED=false
NUVION_ENV=sandbox
NUVION_API_KEY=
NUVION_SANDBOX_BASE_URL=https://api.nuvion.dev
NUVION_PRODUCTION_BASE_URL=https://api.nuvion.co
NUVION_API_VERSION=2026-02-06
NUVION_WEBHOOK_SECRET=
NUVION_ENCRYPTION_PUBLIC_KEY=

# Brails
BRAILS_API_KEY=
BRAILS_API_BASE_URL=https://api.brails.com/v1
BRAILS_WEBHOOK_SECRET=

# EaseID
EASEID_APP_ID=
EASEID_API_KEY=
EASEID_BASE_URL=https://open-api.easeid.ai

# Frontend Vite Variables
VITE_NUVION_API_KEY=
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=
